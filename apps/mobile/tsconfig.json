{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // expo/tsconfig.base's default moduleResolution predates package.json
    // "exports" maps, which @tradex/core and @tradex/types rely on for
    // their subpath exports (e.g. @tradex/core/validators) — override to
    // "bundler", consistent with the rest of the monorepo.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
