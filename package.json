{
  "name": "tradex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tradex — a stock broking platform for Indian markets (NSE/BSE)",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev --filter=@tradex/api --filter=@tradex/web --parallel",
    "dev:mobile": "pnpm --filter @tradex/mobile dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @tradex/db db:generate",
    "db:migrate": "pnpm --filter @tradex/db db:migrate",
    "db:seed": "pnpm --filter @tradex/db db:seed",
    "db:studio": "pnpm --filter @tradex/db db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@tradex/config": "workspace:*",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "5.7.3"
  }
}
